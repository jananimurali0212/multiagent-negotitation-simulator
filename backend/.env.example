# Application Settings
PROJECT_NAME="AI Multi-Agent Negotiation Simulation Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-in-production-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Configuration
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Hosted PostgreSQL Database Settings (Supabase Connection Pooler / Direct)
DATABASE_URL="postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# LLM Provider Configuration & Failover Strategy
PRIMARY_LLM_PROVIDER="gemini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.6-27b"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

FALLBACK_LLM_PROVIDER="rule_fallback"
FALLBACK_API_KEY=""
FALLBACK_MODEL=""

LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
